---
import SonarGrid from './SonarGrid';
const heroStatement = 'I’m a 17-year-old software engineer building interactive websites, apps, and games across different tech stacks. I combine what I learn on my own with ideas and lessons from others.';
const nameLines = ['N.MANDRAKE', 'GABRIEL'];
---
<div class="editorial intro-surface" id="top">
  <SonarGrid background baseOpacity={0.09} amplitude={1.1} maxWaveOpacity={0.3} client:load />
  <nav class="site-nav wrap" aria-label="Main navigation">
    <a class="wordmark monogram" href="#top" aria-label="N. Mandrake Gabriel — home">N.MG<span aria-hidden="true">.</span></a>
    <span class="nav-edition">PORTFOLIO / {new Date().getFullYear()}</span>
  </nav>
  <section class="hero wrap" id="about">
      <p class="eyebrow">01 / INTRODUCTION</p>
    <h1 class="discipline-title" aria-label="N. Mandrake Gabriel">
      {nameLines.map((name) => <span class="name-line" aria-hidden="true">{Array.from(name).map(letter => <span class="name-letter">{letter}</span>)}</span>)}
    </h1>
    <div class="hero-bottom">
      <div class="hero-actions">
        <a class="hero-journey-link" href="#services">Scroll to explore <span aria-hidden="true">↓</span></a>
      </div>
      <div class="hero-copy">
        <p class="role-title" aria-label="Full-stack, backend, frontend, interactive and game developer">
          <span class="role-window" aria-hidden="true"><span class="role-strip"><span>FULL-STACK</span><span>BACKEND</span><span>FRONTEND</span><span>INTERACTIVE</span><span>GAME</span><span>FULL-STACK</span></span></span>
          <span>DEVELOPER</span>
        </p>
        <p class="hero-statement">
          <span class="hero-statement-accessible">{heroStatement}</span>
          <span aria-hidden="true">{heroStatement.split(' ').map((word) => <><span class="hero-copy-word"><span>{word}</span></span>{' '}</>)}</span>
        </p>
      </div>
    </div>
  </section>
  <section class="services wrap" id="services">
    <p class="eyebrow">02 / WHAT I DO</p><h2>WHAT I DO</h2>
    <div class="capability-map">
      <svg class="connections" viewBox="0 0 1000 700" preserveAspectRatio="none" aria-hidden="true"><path class="connection upper" d="M 475 335 L 710 160" pathLength="1"/><path class="connection lower" d="M 475 420 L 680 550" pathLength="1"/></svg>
      <div class="capability anchor-card"><article tabindex="0"><span class="card-number">02</span><h3>BUILD<br/>DIGITAL PRODUCTS</h3><p>Referral workflows, food platforms, and personal dashboards. Interfaces connected to the data and systems behind them.</p><i class="node node-top"></i><i class="node node-bottom"></i></article></div>
      <div class="capability interaction-card"><article tabindex="0"><span class="card-number">01</span><h3>CREATE<br/>INTERACTIONS</h3><p>Typography, transitions, and responsive interfaces. Motion that guides attention and makes each action feel connected.</p><i class="node"></i></article></div>
      <div class="capability game-card"><article tabindex="0"><span class="card-number">03</span><h3>EXPLORE<br/>INTERACTIVE 3D</h3><p>Character animation, camera movement, and spatial navigation. Explore the space journey below to see these experiments in action.</p><i class="node"></i></article></div>
    </div>
  </section>
  <section class="work-entry wrap" id="work" aria-labelledby="work-heading">
    <p class="eyebrow">03 / SELECTED WORK</p>
    <h2 id="work-heading">SELECTED<br/>WORK<span class="small-star" aria-hidden="true">↗</span></h2>
    <p>Scroll into the space to explore each project.</p>
    <div class="journey-entry">
      <span class="journey-rule" aria-hidden="true"></span>
      <a class="text-link" href="#space-experience">ENTER THE SPACE EXPERIENCE <span aria-hidden="true">↓</span></a>
    </div>
  </section>
</div>
<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  // Keep the lines attached to the actual connector dots as cards arrive,
  // settle, or change size. No perpetual animation loop is needed.
  const map = document.querySelector<HTMLElement>('.capability-map');
  const svg = map?.querySelector<SVGSVGElement>('.connections');
  const updateConnections = () => {
    if (!map || !svg || !svg.getClientRects().length) return;
    const rect = svg.getBoundingClientRect();
    if (!rect.width || !rect.height) return;
    const pairs = [
      ['.anchor-card .node-top', '.interaction-card .node', '.connection.upper'],
      ['.anchor-card .node-bottom', '.game-card .node', '.connection.lower'],
    ];
    for (const [from, to, line] of pairs) {
      const a = map.querySelector(from)?.getBoundingClientRect();
      const b = map.querySelector(to)?.getBoundingClientRect();
      if (!a || !b) continue;
      const x = (box: DOMRect) => (box.left + box.width / 2 - rect.left) * 1000 / rect.width;
      const y = (box: DOMRect) => (box.top + box.height / 2 - rect.top) * 700 / rect.height;
      map.querySelector(line)?.setAttribute('d', `M ${x(a)} ${y(a)} L ${x(b)} ${y(b)}`);
    }
  };
  const connectionResize = new ResizeObserver(updateConnections);
  if (map) {
    connectionResize.observe(map);
    map.querySelectorAll('article').forEach(card => connectionResize.observe(card));
  }
  document.addEventListener('astro:before-swap', () => connectionResize.disconnect(), { once: true });
  const media = gsap.matchMedia();
  // Hover transforms belong to the inner article; entrance choreography
  // remains on the outer card, so the two animations never fight.
  media.add('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)', () => {
    const cleanups = Array.from(document.querySelectorAll<HTMLElement>('.capability')).map(card => {
      const article = card.querySelector<HTMLElement>('article');
      if (!article) return () => {};
      let frame = 0;
      let x = 0;
      let y = 0;
      const move = (event: PointerEvent) => {
        const rect = card.getBoundingClientRect();
        x = Math.max(-1, Math.min(1, (event.clientX - rect.left) / rect.width * 2 - 1));
        y = Math.max(-1, Math.min(1, (event.clientY - rect.top) / rect.height * 2 - 1));
        if (frame) return;
        frame = requestAnimationFrame(() => {
          article.style.setProperty('--tilt-x', `${-y * 5}deg`);
          article.style.setProperty('--tilt-y', `${x * 6}deg`);
          article.style.setProperty('--glow-x', `${(x + 1) * 50}%`);
          article.style.setProperty('--glow-y', `${(y + 1) * 50}%`);
          frame = 0;
        });
      };
      const reset = () => {
        cancelAnimationFrame(frame);
        frame = 0;
        ['--tilt-x', '--tilt-y', '--glow-x', '--glow-y'].forEach(property => article.style.removeProperty(property));
      };
      card.addEventListener('pointermove', move);
      card.addEventListener('pointerleave', reset);
      card.addEventListener('pointercancel', reset);
      return () => {
        reset();
        card.removeEventListener('pointermove', move);
        card.removeEventListener('pointerleave', reset);
        card.removeEventListener('pointercancel', reset);
      };
    });
    return () => cleanups.forEach(cleanup => cleanup());
  });
  media.add('(prefers-reduced-motion: no-preference)', () => {
    // Each name row clips its own letters. The sequence runs once and settles.
    const entrance = gsap.timeline({ scrollTrigger: { trigger: '.discipline-title', start: 'top 90%', once: true } });
    document.querySelectorAll('.name-line').forEach((line, index) => {
      entrance.from(line.querySelectorAll('.name-letter'), {
        yPercent: 110, rotation: 3, opacity: 0, duration: .92,
        stagger: .025, ease: 'power4.out', clearProps: 'transform,opacity',
      }, index * .12);
    });
    // Supporting copy waits for the name when already in view, but still has
    // its own viewport trigger on mobile and short screens.
    gsap.timeline({ scrollTrigger: { trigger: '.hero-bottom', start: 'top 94%', once: true } })
      .from('.hero .role-title', { y: 12, opacity: 0, duration: .65, ease: 'power3.out', clearProps: 'transform,opacity' }, .5)
      .from('.hero-copy-word > span', { yPercent: 105, opacity: 0, duration: .65, stagger: .035, ease: 'power3.out', clearProps: 'transform,opacity' }, .58)
      .from('.hero-actions a', { y: 10, opacity: 0, duration: .65, stagger: .1, ease: 'power3.out', clearProps: 'transform,opacity' }, .62);
    // Start at the section heading, not after scrolling down into the card map.
    // Overlap arrivals and line drawing so the composition forms promptly.
    const timeline = gsap.timeline({ onUpdate: updateConnections, onComplete: updateConnections, scrollTrigger: { trigger: '.services h2', start: 'top bottom', once: true, onRefresh: updateConnections } });
    timeline.fromTo('.anchor-card', { x: () => innerWidth * .8, y: -65, rotation: 6, scale: .96 }, { x: -10, y: 5, rotation: -.6, scale: 1, duration: .75, ease: 'power3.out' }, 0)
      .to('.anchor-card', { x: 0, y: 0, rotation: 0, duration: .3, ease: 'sine.inOut' }, .75)
      .from('.connection.upper', { strokeDashoffset: 1, duration: .55, ease: 'power2.inOut' }, .4)
      .from('.interaction-card', { x: 150, y: -60, rotation: 3, scale: .97, duration: .8, ease: 'power3.out' }, .5)
      .from('.connection.lower', { strokeDashoffset: 1, duration: .55, ease: 'power2.inOut' }, .6)
      .from('.game-card', { x: 150, y: 65, rotation: -3, scale: .97, duration: .8, ease: 'power3.out' }, .7)
      .from('.capability .node', { opacity: .25, duration: .4, stagger: .06, ease: 'sine.out' }, .75);
    // Preserve the overlapping choreography, but give each movement time to read.
    timeline.timeScale(.7);
  });
  document.addEventListener('astro:before-swap', () => media.revert(), { once: true });
</script>
