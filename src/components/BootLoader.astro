---
// The page is readable immediately; this slim strip only reports the 3D
// guide streaming in, then fades away. The moon and planets follow silently.
---
<div id="boot-hud" data-stage="loading" data-progress="0" data-state="loading" role="progressbar"
  aria-label="Loading the 3D scene" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
  <div class="boot-track" aria-hidden="true">
    <span class="boot-path"></span>
    <span class="boot-trail" id="boot-trail"></span>
    <span class="boot-rocket" id="boot-rocket">
      <!-- Drawn nose-up, turned to fly right. -->
      <svg viewBox="0 0 190 60" width="44" height="14">
        <g transform="translate(190 0) rotate(90)">
          <g class="boot-flame">
            <path class="boot-flame-outer" d="M18 146 C18 170 26 182 30 190 C34 182 42 170 42 146 Z"/>
            <path class="boot-flame-inner" d="M23 146 C23 162 28 172 30 178 C32 172 37 162 37 146 Z"/>
          </g>
          <g class="boot-hull">
            <path d="M12 110 1 140 12 134 Z M48 110 59 140 48 134 Z"/>
            <path d="M30 4C43 20 48 42 48 70V132H12V70C12 42 17 20 30 4Z"/>
            <path d="M20 132 17 146H43L40 132"/>
            <circle cx="30" cy="62" r="7.5"/>
          </g>
        </g>
      </svg>
    </span>
  </div>
  <span class="boot-label" id="boot-label">LOADING 3D <span id="boot-percent">0</span>%</span>
  <button id="boot-retry" type="button" hidden>RETRY ↻</button>
</div>

<script>
  import { initLoadStrip } from '../scripts/bootLoader.js';
  import { startSceneDownloads } from './sceneDownloads.js';
  // Start the models now, not after the 3D bundle and React have loaded.
  startSceneDownloads();
  initLoadStrip();
</script>

<style is:global>
  #boot-hud {
    --ink: #f3f3f0; --dim: #8c9194; --accent: #b7d7e9; --rocket-w: 44px;
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 30;
    display: flex; align-items: center; gap: 22px; height: 52px; padding: 0 max(4vw, 20px);
    background: linear-gradient(to top, #050505e6, #05050500);
    font: 400 11px/1 var(--font-mono); letter-spacing: .12em; color: var(--dim);
    pointer-events: none; opacity: 0;
    /* Wait half a second before showing, so cached visits never flash it. */
    animation: boot-in 400ms ease 500ms forwards;
    transition: opacity 600ms ease, transform 600ms cubic-bezier(.76, 0, .24, 1);
  }
  @keyframes boot-in { to { opacity: 1; } }
  #boot-hud[data-state="done"] { animation: none; opacity: 0; transform: translateY(100%); transition-delay: 700ms; }
  #boot-hud[hidden] { display: none; }
  .boot-track { position: relative; flex: 1; height: 14px; container-type: inline-size; }
  .boot-path { position: absolute; left: 0; right: 0; top: 50%; height: 1px;
    background: repeating-linear-gradient(90deg, #ffffff30 0 4px, transparent 4px 10px); }
  .boot-trail { position: absolute; left: 0; top: calc(50% - .5px); width: calc(100% - var(--rocket-w)); height: 1px;
    background: linear-gradient(90deg, #ffffff00, var(--accent) 70%, #fff); transform-origin: left; transform: scaleX(0); }
  .boot-rocket { position: absolute; left: 0; top: 0; width: var(--rocket-w); height: 14px; will-change: transform; }
  .boot-rocket svg { display: block; overflow: visible; }
  .boot-hull path, .boot-hull circle { fill: #050505; stroke: var(--ink); stroke-width: 4; stroke-linejoin: round; }
  .boot-flame { transform-box: fill-box; transform-origin: 50% 0%; animation: boot-flicker 120ms steps(2) infinite alternate; }
  .boot-flame-outer { fill: #b7d7e966; }
  .boot-flame-inner { fill: #fff; }
  @keyframes boot-flicker { from { transform: scaleY(.86); } to { transform: scaleY(1.1); } }
  .boot-label { flex: 0 0 auto; min-width: 17ch; text-align: right; font-variant-numeric: tabular-nums; }
  #boot-hud[data-state="done"] .boot-label { color: var(--accent); }
  #boot-hud[data-state="error"] .boot-flame { display: none; }
  #boot-retry { pointer-events: auto; padding: 7px 14px; border: 1px solid var(--ink); border-radius: 99px;
    background: #050505; color: var(--ink); font: inherit; letter-spacing: inherit; cursor: pointer; }
  #boot-retry[hidden] { display: none; }
  #boot-retry:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  @media (max-width: 600px) { #boot-hud { gap: 14px; height: 44px; } .boot-label { min-width: 0; } }
  @media (prefers-reduced-motion: reduce) { #boot-hud { animation-duration: 1ms; } .boot-flame { animation: none; } }
</style>
